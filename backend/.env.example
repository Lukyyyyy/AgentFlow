# 服务器配置
SERVER_PORT=8084

# 数据库配置
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=agentflow
MYSQL_USERNAME=root
MYSQL_PASSWORD=your_mysql_password_here

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# MinIO 配置
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_PRESIGNED_URL_EXPIRY_SECONDS=604800

# JWT 配置（必须修改！建议使用 32 字符以上的随机字符串）
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_change_this_in_production

# 默认管理员账户（生产环境建议禁用或修改）
# 登录仅支持邮箱，默认账户通过 APP_AUTH_DEFAULT_EMAIL 匹配
# 留空则禁用默认账户，必须通过注册功能创建账户
APP_AUTH_DEFAULT_USERNAME=admin
APP_AUTH_DEFAULT_PASSWORD=admin123
APP_AUTH_DEFAULT_EMAIL=765754281@qq.com

# 邮件服务配置（邮箱注册验证码使用）
# 发送通道: smtp(默认) | tencent-ses
MAIL_PROVIDER=smtp
# 通道一：SMTP 直发（无需模板审核；MAIL_HOST 留空则注册功能返回 503）
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=your_email@example.com
MAIL_PASSWORD=your_email_password
MAIL_FROM=AgentFlow <your_email@example.com>
# 端口 465 等隐式 SSL 时设为 true 并将 MAIL_STARTTLS 设为 false
MAIL_SSL=false
MAIL_STARTTLS=true

# 通道二：腾讯云 SES API 模板发送（MAIL_PROVIDER=tencent-ses 时必填，模板需审核通过）
# 密钥在控制台"访问管理-API 密钥管理"创建；区域与发信域名地域一致（如 ap-hongkong）
TENCENT_SES_SECRET_ID=
TENCENT_SES_SECRET_KEY=
TENCENT_SES_REGION=ap-hongkong
TENCENT_SES_FROM_ADDRESS=AgentFlow <agentflow-noreply@mail.lukybetter.com>
TENCENT_SES_VERIFICATION_TEMPLATE_ID=0

# OpenAI 配置（可选，节点配置可覆盖）
OPENAI_API_KEY=sk-your-openai-api-key-here
