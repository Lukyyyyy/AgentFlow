# Copy this file to .env before running Docker Compose.

# MySQL
MYSQL_DATABASE=agentflow
MYSQL_USERNAME=agentflow
MYSQL_PASSWORD=change_me_agentflow_password
MYSQL_ROOT_PASSWORD=change_me_root_password

# MinIO
MINIO_ACCESS_KEY=agentflow-minio
MINIO_SECRET_KEY=change_me_minio_password_at_least_8_chars

# App security
JWT_SECRET=change_me_to_a_random_secret_of_at_least_32_characters
APP_AUTH_DEFAULT_USERNAME=admin
APP_AUTH_DEFAULT_PASSWORD=change_me_admin_password
APP_AUTH_DEFAULT_EMAIL=admin@agentflow.local

# Tencent Cloud SES (email registration)
# Create API credentials in Tencent Cloud CAM, then fill in the two secrets below.
MAIL_PROVIDER=tencent-ses
TENCENT_SES_SECRET_ID=
TENCENT_SES_SECRET_KEY=
TENCENT_SES_REGION=ap-hongkong
TENCENT_SES_FROM_ADDRESS=agentflow-noreply@mail.lukybetter.com
TENCENT_SES_VERIFICATION_TEMPLATE_ID=213823
# Reserved for an administrator-triggered delivery test; public registration does not use it.
TENCENT_SES_TEST_TEMPLATE_ID=213824

# Optional integrations
OPENAI_API_KEY=sk-placeholder
